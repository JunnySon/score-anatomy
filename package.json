{
  "name": "score-anatomy",
  "private": true,
  "version": "0.3.4",
  "description": "수능 수학 모고칸 모바일 웹앱 v1 시제품",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single && node scripts/inline-single.mjs",
    "build:variant": "vite build --mode variant",
    "build:artifact": "npm run build:single && node scripts/make-artifact.mjs",
    "build:app": "node scripts/build-app.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "npm run build && npm run build:single && npm run build:variant && node scripts/make-artifact.mjs && playwright test --trace off",
    "verify": "node scripts/verify.mjs",
    "package": "node scripts/package.mjs",
    "exams:check": "node scripts/exams.mjs check",
    "exams:answers": "node scripts/exams.mjs answers",
    "exams:cuts": "node scripts/exams.mjs cuts",
    "exams:publish": "node scripts/exams.mjs publish",
    "exams:verify": "node scripts/exams.mjs verify",
    "exams:keygen": "node scripts/exams.mjs keygen",
    "exams:serve": "node scripts/exams.mjs serve",
    "exams:testdata": "node scripts/exams.mjs testdata"
  },
  "dependencies": {
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
